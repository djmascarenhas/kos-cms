{
  "name": "kos-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Portal institucional e plataforma KOS do Conselho Municipal de Saúde de Chapada dos Guimarães - MT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:cms": "npm run dev --workspace=apps/cms",
    "dev:kos": "npm run dev --workspace=apps/kos",
    "build:cms": "npm run build --workspace=apps/cms",
    "build:kos": "npm run build --workspace=apps/kos",
    "db:apply": "psql %DATABASE_URL% -f packages/database/migrations/0001_initial_schema.sql",
    "db:users": "psql %ADMIN_DATABASE_URL% -f packages/database/migrations/0005_users_and_document_history.sql",
    "db:drive:migrate": "psql %ADMIN_DATABASE_URL% -f packages/database/migrations/0006_google_drive_inventory.sql",
    "db:drive:seed": "psql %ADMIN_DATABASE_URL% -f packages/database/seeds/0006_google_drive_inventory.sql",
    "db:classification:migrate": "psql %ADMIN_DATABASE_URL% -f packages/database/migrations/0007_document_classification.sql",
    "db:classification:seed": "psql %ADMIN_DATABASE_URL% -f packages/database/seeds/0007_document_classification.sql",
    "db:protocols:migrate": "psql %ADMIN_DATABASE_URL% -f packages/database/migrations/0008_received_document_protocols.sql",
    "db:kos:migrate": "psql %ADMIN_DATABASE_URL% -f packages/database/migrations/0009_kos_document_analysis.sql",
    "db:seed": "psql %DATABASE_URL% -f packages/database/seeds/0001_reference_data.sql",
    "lint:cms": "npm run lint --workspace=apps/cms",
    "lint:kos": "npm run lint --workspace=apps/kos"
  }
}

{
  "name": "kos-cms",
  "version": "0.1.0",
  "private": true,
  "description": "Portal institucional e plataforma KOS do Conselho Municipal de Saúde de Chapada dos Guimarães - MT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:cms": "npm run dev --workspace=apps/cms",
    "dev:kos": "npm run dev --workspace=apps/kos",
    "build:cms": "npm run build --workspace=apps/cms",
    "build:kos": "npm run build --workspace=apps/kos",
    "db:apply": "psql %DATABASE_URL% -f packages/database/migrations/0001_initial_schema.sql",
    "db:seed": "psql %DATABASE_URL% -f packages/database/seeds/0001_reference_data.sql",
    "db:apply": "psql %DATABASE_URL% -f packages/database/migrations/0001_initial_schema.sql",
    "db:seed": "psql %DATABASE_URL% -f packages/database/seeds/0001_reference_data.sql",
    "lint:cms": "npm run lint --workspace=apps/cms",
    "lint:kos": "npm run lint --workspace=apps/kos"
  }
}
